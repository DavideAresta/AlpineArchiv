{"files":[{"path":"src/main/resources/db/migration/V1__initial_schema.sql","content":"CREATE TABLE game_session (\n    id VARCHAR(36) PRIMARY KEY,\n    mode VARCHAR(10) NOT NULL CHECK (mode IN ('PVP', 'CPU')),\n    current_turn VARCHAR(1) NOT NULL DEFAULT 'X' CHECK (current_turn IN ('X', 'O')),\n    status VARCHAR(10) NOT NULL DEFAULT 'IN_PROGRESS' CHECK (status IN ('IN_PROGRESS', 'WIN', 'DRAW')),\n    winner VARCHAR(1) CHECK (winner IN ('X', 'O')),\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\n);\n\nCREATE TABLE board_state (\n    id BIGSERIAL PRIMARY KEY,\n    session_id VARCHAR(36) NOT NULL REFERENCES game_session(id),\n    cell_index INT NOT NULL CHECK (cell_index BETWEEN 0 AND 8),\n    symbol VARCHAR(1) NOT NULL CHECK (symbol IN ('X', 'O')),\n    placed_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\n);\n\nCREATE INDEX idx_board_state_session_id ON board_state(session_id);\n\nCREATE TABLE scoreboard (\n    id BIGSERIAL PRIMARY KEY,\n    session_id VARCHAR(36) NOT NULL REFERENCES game_session(id),\n    x_wins INT NOT NULL DEFAULT 0,\n    o_wins INT NOT NULL DEFAULT 0,\n    draws INT NOT NULL DEFAULT 0,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\n);\n\nCREATE INDEX idx_scoreboard_session_id ON scoreboard(session_id);\n\n-- ROLLBACK SECTION\n-- DROP TABLE IF EXISTS scoreboard CASCADE;\n-- DROP TABLE IF EXISTS board_state CASCADE;\n-- DROP TABLE IF EXISTS game_session CASCADE;","fileType":"sql","purpose":"Initial schema setup for game session, board state, and scoreboard tables with constraints and indexes"},{"path":"src/main/resources/db/migration/V2__seed_data.sql","content":"INSERT INTO game_session (id, mode, current_turn, status) VALUES \n('session-00000000000000000000000000000001', 'PVP', 'X', 'IN_PROGRESS'),\n('session-00000000000000000000000000000002', 'CPU', 'O', 'IN_PROGRESS');\n\nINSERT INTO board_state (session_id, cell_index, symbol) VALUES \n('session-00000000000000000000000000000001', 0, 'X'),\n('session-00000000000000000000000000000